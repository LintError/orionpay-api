# ─────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=orionpay

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────
# Change this to a long random string in production.
JWT_SECRET=change_me_in_production

# ─────────────────────────────────────────────
# Blockchain / Multi-chain
# ─────────────────────────────────────────────
# Comma-separated "chain:rpcUrl" pairs.
# Stellar uses a Horizon URL; EVM chains use a JSON-RPC URL.
BLOCKCHAIN_RPC_URLS=stellar:https://horizon-testnet.stellar.org,ethereum:https://rpc.ankr.com/eth,polygon:https://polygon-rpc.com

# Comma-separated "chain:type" pairs. type is one of: stellar | evm
SUPPORTED_CHAINS=stellar:stellar,ethereum:evm,polygon:evm

# Use the Stellar test network (true) or public/mainnet (false).
STELLAR_TESTNET=true

# ─────────────────────────────────────────────
# Python AI Engine
# ─────────────────────────────────────────────
# Base URL of the FastAPI AI engine (see /ai).
AI_SERVICE_URL=http://localhost:8000/api/v1
